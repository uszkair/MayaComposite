<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20241107-2" author="RobertUszkai">
        <!-- Tábla létrehozása a felhasználói adatok tárolására -->
        <createTable tableName="USER">
            <!-- Egyedi azonosító UUID formátumban -->
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Felhasználó e-mail címe -->
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Felhasználó jelszava (titkosított formában) -->
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Létrehozás dátuma és ideje (audit oszlop) -->
            <column name="created_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>

            <!-- Létrehozó felhasználó (audit oszlop) -->
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Utolsó módosítás dátuma és ideje (audit oszlop) -->
            <column name="last_modified_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>

            <!-- Módosító felhasználó (audit oszlop) -->
            <column name="last_modified_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index létrehozása a "email" oszlopra a gyorsabb keresés érdekében -->
        <createIndex indexName="idx_user_email" tableName="USER">
            <column name="email"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
