<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF">
    <Properties>
        <Property name="LOG_LOC">logs</Property>
        <Property name="MAX">5</Property>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level [%X{correlationId}] [%X{requestId}] %logger{36} - %msg%n
        </Property>
    </Properties>
    <Appenders>
        <RollingFile name="FILE" fileName="${LOG_LOC}/maya.log" filePattern="${LOG_LOC}/archived/maya.%d{yyyy-MM-dd}.%i.log">
            <PatternLayout>
                <Pattern>${LOG_PATTERN}</Pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy />
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="250 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="${MAX}" />
        </RollingFile>
        <Console name="STDOUT" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="${LOG_PATTERN}" />
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.axasoft.mayacomposite" level="debug" />
        <Logger name="file" level="debug" additivity="false">
            <appender-ref ref="FILE" />
        </Logger>
        <Root level="debug">
            <AppenderRef ref="FILE" />
            <AppenderRef ref="STDOUT" />
        </Root>
    </Loggers>
</Configuration>